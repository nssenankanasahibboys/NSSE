{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!assets/|src/|favicon\\.ico|favicon\\.png|favicon-32x32\\.png).*)",
      "destination": "/index.html"
    }
  ]
}
